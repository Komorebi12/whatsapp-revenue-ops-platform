# Real integration env template.
#
# Copy this file to deploy/.env for local-only real integration testing.
# Never commit deploy/.env. Never use real credentials in screenshots,
# demo videos, public docs, or the clean public release tree.

MOCK_MODE=false

## Local database and service URLs

DATABASE_URL=
GHL_SYNC_BASE_URL=http://ghl-sync:8010
GEMINI_BASE_URL=

## Shared internal auth

AGENT_AUTH_SECRET=
MVP_REPLY_WEBHOOK_SECRET=
GHL_SYNC_AUTH_SECRET=
SYNC_AUTH_SECRET=

## Gemini / GHL

GEMINI_API_KEY=
GEMINI_MODEL=
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_LEAD_CAPTURE_ID=
GHL_STAGE_QUALIFICATION_ID=
GHL_STAGE_WON_ID=
GHL_STAGE_LOST_ID=
GHL_INTENT_FIELD_KEY=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
SYNC_SOURCE_SYSTEM=

## n8n

N8N_ENCRYPTION_KEY=

## RAG / Qdrant

QDRANT_COLLECTION=whatsapp_demo_knowledge
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

## Optional operator console

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
