# WhatsApp Revenue Ops Platform env variable reference
#
# This file is a public, non-runnable inventory of supported variables.
# For the safe local demo path, use deploy/.env.mock.
# For real third-party integrations, copy deploy/.env.real.example to a
# local-only deploy/.env and fill values outside git.

## Mode

MOCK_MODE=

## Local database and service URLs

DATABASE_URL=
GHL_SYNC_BASE_URL=
GEMINI_BASE_URL=

## Shared internal auth

AGENT_AUTH_SECRET=
MVP_REPLY_WEBHOOK_SECRET=
GHL_SYNC_AUTH_SECRET=
SYNC_AUTH_SECRET=

## Sales-agent / GHL integration

GEMINI_API_KEY=
GEMINI_MODEL=
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_LEAD_CAPTURE_ID=
GHL_STAGE_QUALIFICATION_ID=
GHL_STAGE_WON_ID=
GHL_STAGE_LOST_ID=
GHL_INTENT_FIELD_KEY=
GHL_API_BASE_URL=
GHL_API_VERSION=
SYNC_SOURCE_SYSTEM=

## n8n

N8N_ENCRYPTION_KEY=

## RAG / Qdrant

QDRANT_COLLECTION=
EMBEDDING_MODEL=
LLM_MODEL=

## Optional operator console

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
