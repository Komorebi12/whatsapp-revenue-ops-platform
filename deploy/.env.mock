# Public mock-first environment.
#
# Safe to commit. This file contains only local demo values and placeholders.
# It routes CRM traffic to ghl-mock and routes the sales-agent LLM client to
# ghl-mock's OpenAI-compatible /mock-gemini endpoint.

MOCK_MODE=true

## Local database and service URLs

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/revenue_ops
GHL_SYNC_BASE_URL=http://ghl-sync:8010
GEMINI_BASE_URL=http://ghl-mock:8090/mock-gemini

## Shared internal auth, demo-only

AGENT_AUTH_SECRET=mock-agent-secret
MVP_REPLY_WEBHOOK_SECRET=mock-console-secret
GHL_SYNC_AUTH_SECRET=mock-sync-secret
SYNC_AUTH_SECRET=mock-sync-secret

## Sales-agent / GHL mock defaults

GEMINI_API_KEY=
GEMINI_MODEL=mock-gemini
GHL_API_TOKEN=mock-ghl-token
GHL_LOCATION_ID=loc_mock_001
GHL_PIPELINE_ID=pipe_mock_001
GHL_STAGE_LEAD_CAPTURE_ID=stage_mock_lead_capture
GHL_STAGE_QUALIFICATION_ID=stage_mock_qualification
GHL_STAGE_WON_ID=stage_mock_won
GHL_STAGE_LOST_ID=stage_mock_lost
GHL_INTENT_FIELD_KEY=whatsapp_intent
GHL_API_BASE_URL=http://ghl-mock:8090
GHL_API_VERSION=2021-07-28
SYNC_SOURCE_SYSTEM=whatsapp_demo

## n8n demo settings

N8N_ENCRYPTION_KEY=mock-n8n-encryption-key-for-local-demo-only

## RAG defaults
#
# The core sales/CRM demo does not call RAG and does not require Gemini.
# The optional real RAG path still requires a real Gemini API key for document
# embedding and answer generation; use deploy/.env.real.example for that path.

QDRANT_COLLECTION=whatsapp_demo_knowledge
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

## Optional operator console

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
